CONFIG_AODV_EN_APP_USE_APP_DEMO=y
CONFIG_AODV_EN_APP_NODE_NAME="C1_RELAY"
CONFIG_AODV_EN_APP_NETWORK_ID=0xA0DE0001
CONFIG_AODV_EN_APP_WIFI_CHANNEL=6
CONFIG_AODV_EN_APP_HELLO_INTERVAL_MS=1000
CONFIG_AODV_EN_APP_SEND_INTERVAL_MS=2000
CONFIG_AODV_EN_APP_PRINT_INTERVAL_MS=3000
CONFIG_AODV_EN_APP_REPORT_INTERVAL_MS=4000
CONFIG_AODV_EN_APP_TX_POWER_QDBM=10
